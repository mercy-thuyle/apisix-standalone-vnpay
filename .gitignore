# ── Secrets & credentials ─────────────────────────────────────
.env
secrets/.netrc

# ── Private keys ──────────────────────────────────────────────
certs/*.key

# ── Patched APISIX internals (generated by 1-patch-template-lua.sh) ──
ngx_tpl.lua
ngx_tpl.lua.orig
init.lua
init.lua.orig

# ── gitsync runtime (managed by git-sync, not committed) ──────
conf_routes/.git/
conf_routes/.worktrees/
conf_routes/current
conf_routes/sync.log

# ── Injected route files (cert injected, not committed) ───────
conf_routes/apisix_routes/*.bak

# ── Logs ──────────────────────────────────────────────────────
logs/

# ── macOS ─────────────────────────────────────────────────────
.DS_Store
.AppleDouble
.LSOverride